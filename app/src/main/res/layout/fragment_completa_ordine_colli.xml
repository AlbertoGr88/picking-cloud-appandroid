<?xml version="1.0" encoding="utf-8"?>
<android.support.design.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@id/ordiniCoordinatorLayout" android:layout_width="match_parent" android:layout_height="match_parent">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:orientation="vertical" android:background="@color/lightgrey2" android:paddingLeft="8dp" android:paddingTop="@dimen/activity_vertical_margin" android:paddingRight="8dp" android:paddingBottom="@dimen/activity_vertical_margin" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:textSize="12sp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/aggiungi_collo" android:textAllCaps="true" android:textAlignment="center">
                </TextView>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp">
                    <EditText android:id="@id/collo_larghezza" android:hint="@string/L" style="@style/DimensioneColloEdit">
                    </EditText>
                    <EditText android:id="@id/collo_altezza" android:hint="@string/A" style="@style/DimensioneColloEdit">
                    </EditText>
                    <EditText android:id="@id/collo_profondita" android:hint="@string/P" style="@style/DimensioneColloEdit">
                    </EditText>
                    <EditText android:id="@id/collo_peso" android:hint="@string/KG" android:digits="0123456789.," style="@style/DimensioneColloEdit">
                    </EditText>
                    <Button android:id="@id/btn_aggiungi_collo" android:paddingLeft="0dp" android:paddingTop="2dp" android:paddingRight="0dp" android:paddingBottom="2dp" android:layout_width="80dp" android:layout_height="wrap_content" android:layout_margin="0dp" android:layout_marginTop="0dp" android:text="@string/plus" android:ems="1" style="@style/AppTheme.Button.Secondary">
                    </Button>
                </LinearLayout>
            </LinearLayout>
            <android.support.v7.widget.RecyclerView android:id="@id/colliRecyclerView" android:scrollbars="none" android:layout_width="match_parent" android:layout_height="wrap_content">
            </android.support.v7.widget.RecyclerView>
            <android.support.design.widget.TextInputLayout android:id="@id/ordine_note_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                <EditText android:textSize="16sp" android:gravity="top|start" android:id="@id/ordine_note" android:layout_marginLeft="16dp" android:layout_marginRight="16dp" android:hint="@string/NOTE" android:lines="5" android:minLines="5" android:ems="10" android:inputType="textMultiLine" android:textAllCaps="false" android:textAlignment="viewStart" style="@style/EditText">
                </EditText>
            </android.support.design.widget.TextInputLayout>
            <Button android:id="@id/btn_colli_chiudi" android:visibility="visible" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginLeft="16dp" android:layout_marginRight="16dp" android:layout_marginBottom="16dp" android:text="@string/chiudi_ordine" style="@style/AppTheme.Button.Primary">
            </Button>
        </LinearLayout>
    </ScrollView>
</android.support.design.widget.CoordinatorLayout>
