<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BaseTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:screenOrientation">portrait</item>
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:windowSoftInputMode">stateHidden</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="colorPrimary">@color/primaryColor</item>
        <item name="colorPrimaryDark">@color/primaryDarkColor</item>
        <item name="colorAccent">@color/primaryDarkColor</item>
        <item name="coordinatorLayoutStyle">@style/Widget.Design.CoordinatorLayout</item>
    </style>

    <style name="AppTheme" parent="BaseTheme" />

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="AppTheme.Button" parent="AppTheme">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">@font/montserrat_bold</item>
    </style>

    <style name="AppTheme.Button.Danger" parent="AppTheme.Button">
        <item name="android:textColor">@color/primaryTextColor</item>
        <item name="android:backgroundTint">@color/lightRed</item>
    </style>

    <style name="AppTheme.Button.Primary" parent="AppTheme.Button">
        <item name="android:textColor">@color/primaryTextColor</item>
        <item name="android:backgroundTint">@color/primaryColor</item>
    </style>

    <style name="AppTheme.Button.Secondary" parent="AppTheme.Button">
        <item name="android:textColor">@color/secondaryTextColor</item>
        <item name="android:backgroundTint">@color/lightYellow</item>
    </style>

    <style name="AppTheme.Button.Success" parent="AppTheme.Button">
        <item name="android:textColor">@color/primaryTextColor</item>
        <item name="android:backgroundTint">@color/lightGreen</item>
    </style>

    <style name="DimensioneCollo">
        <item name="android:orientation">vertical</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ems">1</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="DimensioneColloEdit">
        <item name="android:textSize">16sp</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ems">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:digits">0123456789</item>
        <item name="android:layout_weight">1</item>
        <item name="android:inputType">numberDecimal</item>
        <item name="android:imeOptions">actionNext</item>
        <item name="android:textAlignment">center</item>
    </style>

    <style name="DimensioneColloLabel">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/lightgrey3</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textAlignment">center</item>
    </style>

    <style name="DimensioneColloValore">
        <item name="android:textSize">16sp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAlignment">center</item>
    </style>

    <style name="EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:inputType">text</item>
    </style>

    <style name="FloatingActionButton">
        <item name="android:layout_gravity">bottom|end</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:src">@drawable/ic_add</item>
        <item name="android:layout_marginEnd">16dp</item>
    </style>

    <style name="Logo">
        <item name="android:layout_width">200dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:adjustViewBounds">true</item>
    </style>

    <style name="ProgressBar">
        <item name="android:layout_gravity">center</item>
        <item name="android:visibility">gone</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="Riga">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">@dimen/pick_riga_min_height</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingTop">@dimen/pick_riga_padding_v</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:paddingBottom">@dimen/pick_riga_padding_v</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="Riga.Lightgrey" parent="Riga">
        <item name="android:background">@color/lightgrey2</item>
    </style>

    <style name="Riga.White" parent="Riga">
        <item name="android:background">@android:color/white</item>
    </style>

    <style name="RigaContent">
        <item name="android:textAppearance">?attr/textAppearanceListItemSecondary</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">4</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="RigaContentNoAllCaps" parent="RigaContent">
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="RigaHeader">
        <item name="android:textAppearance">?attr/textAppearanceListItemSecondary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">2</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="SearchBox">
        <item name="android:textSize">16sp</item>
        <item name="android:clickable">true</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ems">10</item>
        <item name="android:singleLine">true</item>
        <item name="android:textAlignment">center</item>
    </style>

    <style name="SplashTheme" parent="AppTheme">
        <item name="android:screenOrientation">portrait</item>
        <item name="android:windowBackground">@drawable/splash_theme</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
    </style>
</resources>
